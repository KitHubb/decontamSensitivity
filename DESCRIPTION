Encoding: UTF-8
Depends:
    R (>= 4.1.0)
Imports:
    ggplot2,
    methods
Suggests:
    decontam,
    devtools,
    knitr,
    phyloseq,
    rmarkdown,
    testthat (>= 3.0.0)
Config/testthat/edition: 3
Config/roxygen2/version: 8.0.0
